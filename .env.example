# ==============================================================================
# Azaroth Enterprise Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Backend API Configuration
# Local Development: http://localhost:3001
# Production: https://api.azaroth-techhive.com
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=5000

# CMS Write Mode ('local' [localStorage draft default] | 'staging' [isolated staging API])
# Remote database writes remain DISABLED ('local') until an isolated development database is verified.
VITE_CMS_WRITE_MODE=local

# ------------------------------------------------------------------------------
# Database Configuration & Environment Isolation
# ------------------------------------------------------------------------------
# Production / Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/neondb?sslmode=prefer
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/neondb

# Isolated Development Database URL (Protects production from local schema changes)
DEV_DATABASE_URL=postgresql://user:password@localhost:5432/azaroth_dev

# Mandatory Test Database URL for database-mutating automated tests
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/azaroth_test

# Neon Branch Indicator ('production' | 'development' | 'staging')
NEON_BRANCH=development

# Explicit production mutation guard (must be 'true' only in production for authorized writes)
ALLOW_PRODUCTION_MUTATIONS=false

# ------------------------------------------------------------------------------
# Cloud Storage Configuration (Cloudflare R2 / S3 / Local)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.azaroth-techhive.com
VITE_STORAGE_PUBLIC_URL=https://media.azaroth-techhive.com

# ------------------------------------------------------------------------------
# Email Service Configuration (Brevo SMTP)
# ------------------------------------------------------------------------------
EMAIL_FROM=hello@azaroth-techhive.com
ADMIN_EMAIL=admin@azaroth-techhive.com
SUPPORT_EMAIL=support@azaroth-techhive.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@smtp-brevo.com
SMTP_PASS=your-smtp-master-password
BREVO_API_KEY=your-brevo-api-key

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
AUTH_SECRET=your-secure-random-auth-secret-at-least-32-chars
COOKIE_SECRET=your-secure-cookie-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Analytics & Observability (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=
VITE_ENABLE_HOTJAR=false
